# Keep generated dependency lockfiles committed for reproducible machines.

# Secrets and machine-local state must never enter this public repository.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials
credentials.*
*.credentials
secrets
secrets.*
*.secrets
*.local
*.local.*
.zsh_history
.bash_history
.python_history
.node_repl_history
history
*.history
.DS_Store

# Vedup runtime data belongs under XDG state/data directories, not source.
.vedup-state/
logs/
backups/
dist/
